---
import * as prismic from "@prismicio/client";
import { getAllPosts } from "../../lib/prismicio";
import type { ProjectDocument } from "../../types/prismic";
import ArrowIcon from "../../components/ui/icons/ArrowIcon.astro";
import PrismicRichText from "../../components/ui/PrismicRichText.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.uid },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: ProjectDocument;
  allPosts: ProjectDocument[];
}

const { post, allPosts } = Astro.props;

const title = prismic.asText(post.data.title);
const thumbnail = post.data.miniatura?.url;
const clientName = post.data.client_name;
const year = post.data.year;
const category = post.data.category;
const roles = post.data.roles_group.map((item) => item.role).filter(Boolean);
const firstText = post.data.first_text;
const secondText = post.data.second_text;
const gallery = post.data.gallery;

const otherProjects = allPosts
  .filter((p) => p.uid !== post.uid && p.data.category === category)
  .slice(0, 3);

const otherUids = new Set([post.uid, ...otherProjects.map((p) => p.uid)]);

const fallbackProjects = allPosts
  .filter((p) => !otherUids.has(p.uid))
  .slice(0, 3 - otherProjects.length);

const relatedProjects = [...otherProjects, ...fallbackProjects];
---

<Layout
  title={`Corte Films | ${title}`}
  description={prismic.asText(firstText) || undefined}
  ogImage={thumbnail ?? undefined}
>
  <div class="pb-12">
    <div class="container px-4 mx-auto">
      <article class="justify-between gap-24 py-12">
        <div class="text-neutral-200 space-y-2 py-4">
          <div id="hero-meta" class="text-sm font-univers-ex text-neutral-400">
            {year} | {category} | {roles.join(", ")} | {clientName}
          </div>
          <div class="overflow-hidden">
            <h1 id="hero-title" class="text-5xl font-akira">{title}</h1>
          </div>
        </div>
        <div
          id="hero-image"
          class="bg-neutral-800 w-full aspect-video flex items-center justify-center text-white text-xl font-univers-ex tracking-wide shrink-0 overflow-hidden"
          style={`view-transition-name: portfolio-hero-${post.uid}`}
        >
          {
            thumbnail && (
              <img
                src={thumbnail}
                alt={`${title} thumbnail`}
                class="w-full h-full object-cover"
              />
            )
          }
        </div>
        <div class="py-4 space-y-6">
          <PrismicRichText field={firstText} id="desc-1" />
          <PrismicRichText field={secondText} id="desc-2" />
        </div>
      </article>
    </div>
    <div class="w-full">
      <div
        id="project-banner"
        class="bg-neutral-800 h-128 mx-auto max-w-600 flex items-center justify-center text-white text-xl font-univers-ex tracking-wide"
      >
        {title}
      </div>
    </div>
    <div class="container px-4 mx-auto">
      <PrismicRichText field={secondText} id="desc-3" class="py-8" />
    </div>
    {
      gallery.length > 0 && (
        <div class="container mx-auto py-4">
          <div class="grid md:grid-cols-3 grid-cols-1 gap-4">
            {gallery.map((item) =>
              item.image?.url ? (
                <img
                  src={item.image.url}
                  alt={item.image.alt ?? ""}
                  class="aspect-square w-full object-cover rounded-md"
                />
              ) : (
                <div class="aspect-square w-full bg-neutral-400 rounded-md" />
              ),
            )}
          </div>
        </div>
      )
    }
    <div class="container px-4 mx-auto">
      <section class="py-12">
        <div class="overflow-hidden">
          <h2 id="others-title" class="text-6xl font-akira text-neutral-200">
            Otros Proyectos
          </h2>
        </div>
        <div
          id="others-grid"
          class="grid grid-cols-1 md:grid-cols-3 gap-8 py-8"
        >
          {
            relatedProjects.map((related) => (
              <a href={`/portfolio/${related.uid}`}>
                <div
                  class="bg-neutral-800 h-64 flex items-center justify-center text-white font-univers-ex tracking-wide hover:bg-neutral-700 transition-colors overflow-hidden"
                  style={`view-transition-name: portfolio-hero-${related.uid}`}
                >
                  {related.data.miniatura?.url ? (
                    <img
                      src={related.data.miniatura.url}
                      alt={prismic.asText(related.data.title)}
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    prismic.asText(related.data.title)
                  )}
                </div>
              </a>
            ))
          }
        </div>
        <div>
          <a
            href="/portfolio"
            class="flex ml-auto w-max items-center text-neutral-500 font-akira group hover:text-neutral-200 transition-colors"
          >
            VER TODOS LOS PROYECTOS
            <div
              class="w-8 group-hover:translate-x-2 transition-transform duration-500 ease-in-out"
            >
              <ArrowIcon />
            </div>
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import { gsap, ScrollTrigger, SplitText } from "../../lib/gsap";

  let ctx: gsap.Context | null = null;

  function initAnimations() {
    // --- Hero meta fade in ---
    const heroMeta = document.getElementById("hero-meta");
    if (heroMeta) {
      gsap.from(heroMeta, {
        opacity: 0,
        y: 16,
        duration: 0.6,
        ease: "power2.out",
      });
    }

    // --- Hero title: chars slide up ---
    const heroTitle = document.getElementById("hero-title");
    if (heroTitle) {
      const splitTitle = new SplitText(heroTitle, { type: "chars" });
      gsap.from(splitTitle.chars, {
        opacity: 0,
        y: "100%",
        stagger: 0.03,
        duration: 0.7,
        ease: "power3.out",
        delay: 0.15,
      });
    }

    // --- Description paragraphs: fade up on scroll ---
    ["desc-1", "desc-2", "desc-3"].forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      gsap.from(el, {
        opacity: 0,
        y: 40,
        duration: 0.8,
        ease: "power2.out",
        scrollTrigger: {
          trigger: el,
          start: "top 88%",
        },
      });
    });

    // --- Project banner fade in ---
    const banner = document.getElementById("project-banner");
    if (banner) {
      gsap.from(banner, {
        opacity: 0,
        y: 30,
        duration: 0.9,
        ease: "power2.out",
        scrollTrigger: {
          trigger: banner,
          start: "top 88%",
        },
      });
    }

    // --- "Otros Proyectos" h2: chars slide up ---
    const othersTitle = document.getElementById("others-title");
    if (othersTitle) {
      const splitH2 = new SplitText(othersTitle, { type: "chars" });
      gsap.from(splitH2.chars, {
        opacity: 0,
        y: "100%",
        stagger: 0.025,
        duration: 0.65,
        ease: "power3.out",
        scrollTrigger: {
          trigger: othersTitle,
          start: "top 88%",
        },
      });
    }

    // --- Related project cards: stagger fade up ---
    const othersGrid = document.getElementById("others-grid");
    if (othersGrid) {
      const cards = othersGrid.querySelectorAll("a");
      gsap.from(cards, {
        opacity: 0,
        y: 60,
        stagger: 0.15,
        duration: 0.8,
        ease: "power2.out",
        scrollTrigger: {
          trigger: othersGrid,
          start: "top 88%",
        },
      });
    }
  }

  document.addEventListener("astro:page-load", () => {
    // Guard: only run on portfolio detail pages
    if (!document.getElementById("hero-title")) return;

    ctx = gsap.context(() => initAnimations());
  });

  document.addEventListener("astro:before-swap", () => {
    ctx?.revert();
    ctx = null;
  });
</script>
