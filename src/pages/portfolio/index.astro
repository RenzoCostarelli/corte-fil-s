---
import { categories } from "../../data";
import { getAllPosts } from "../../lib/prismicio";
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";

const posts = await getAllPosts();
---

<Layout
  title="Portfolio | Corte Films"
  description="Nuestra selección de proyectos audiovisuales."
>
  <section
    class="min-h-svh space-y-12 py-12 bg-neutral-50"
    data-portfolio-section
  >
    <script>
      import { gsap, ScrollTrigger } from "../../lib/gsap";

      const cardTriggers = new Map<HTMLElement, ScrollTrigger>();

      const section = document.querySelector("[data-portfolio-section]");

      if (section) {
        const filterButtons = gsap.utils.toArray<HTMLElement>(
          "[data-filter-btn]",
          section,
        );
        const projectCards = gsap.utils.toArray<HTMLElement>(
          "[data-project-card]",
          section,
        );

        const categoriesTl = gsap
          .timeline({ paused: true })
          .from(filterButtons, {
            opacity: 0,
            y: -20,
            stagger: 0.1,
            duration: 0.6,
            ease: "power2.out",
          });

        ScrollTrigger.create({
          trigger: "[data-categories]",
          start: "top 75%",
          end: "top center",
          animation: categoriesTl,
          scrub: true,
        });

        function createCardTrigger(card: HTMLElement) {
          cardTriggers.get(card)?.kill();
          gsap.set(card, { opacity: 0, y: 60 });
          const tl = gsap.timeline({ paused: true }).to(card, {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: "power3.out",
          });
          const trigger = ScrollTrigger.create({
            trigger: card,
            start: "top 80%",
            animation: tl,
            toggleActions: "play none none none",
            once: true,
          });
          cardTriggers.set(card, trigger);
        }

        // Category filter logic
        function applyFilter(filter: string) {
          filterButtons.forEach((btn: HTMLElement) => {
            const isActive = btn.dataset.filterBtn === filter;
            btn.classList.toggle("text-neutral-950", isActive);
            btn.classList.toggle("text-neutral-400", !isActive);
          });

          projectCards.forEach((card: HTMLElement) => {
            const visible =
              filter === "Todos" || card.dataset.categoryItem === filter;
            if (!visible) {
              cardTriggers.get(card)?.kill();
              cardTriggers.delete(card);
              card.style.display = "none";
            } else {
              card.style.display = "";
            }
          });

          ScrollTrigger.refresh();

          projectCards
            .filter((c: HTMLElement) => c.style.display !== "none")
            .forEach(createCardTrigger);

          ScrollTrigger.refresh();
        }

        filterButtons.forEach((btn: HTMLElement) => {
          btn.addEventListener("click", () => {
            applyFilter(btn.dataset.filterBtn ?? "Todos");
          });
        });

        applyFilter("Todos");
      }
    </script>
    <div class="px-4 mx-auto">
      <h1 class="font-akira text-5xl text-neutral-950">Portfolio</h1>
      <p class="font-univers-ex text-2xl text-pretty text-neutral-950">
        Nuestra selección de proyectos
      </p>
      <div
        class="flex items-center justify-end gap-6 pt-8 px-2"
        data-categories
      >
        <button
          class="text-neutral-950 cursor-pointer hover:text-neutral-950 text-xl font-univers-ex tracking-wider"
          data-filter-btn="Todos"
        >
          Todos
        </button>
        {
          categories.map((category) => (
            <button
              class="text-neutral-400 cursor-pointer hover:text-neutral-950 text-xl font-univers-ex tracking-wider text-pretty"
              data-filter-btn={category.name}
            >
              {category.name}
            </button>
          ))
        }
      </div>
      <div class="space-y-8 py-8" data-projects>
        {posts.map((post) => <ProjectCard post={post} from="/portfolio" />)}
      </div>
    </div>
  </section>
</Layout>
