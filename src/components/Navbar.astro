---
import { icons, navItems, social } from "../data";
import Close from "./ui/icons/Close.astro";
import Logo from "./ui/Logo.astro";
---

<div>
  <button
    type="button"
    class="w-24 space-y-3 group cursor-pointer"
    data-menu-button
  >
    <div
      class="h-2 bg-neutral-700 group-hover:bg-neutral-200 w-full origin-left group-hover:-rotate-4 transition-all duration-500 ease-in-out"
    >
    </div>
    <div
      class="h-2 bg-neutral-700 group-hover:bg-neutral-200 transition-colors duration-500 w-full"
    >
    </div>
    <div
      class="h-2 bg-neutral-700 group-hover:bg-neutral-200 transition-colors duration-500 w-full"
    >
    </div>
  </button>
  <!-- MENU -->
  <div
    class="fixed w-vw h-svh inset-0 bg-neutral-900/50 z-9999 hidden"
    data-navbar
  >
    <div
      class="w-max ml-auto bg-neutral-50 h-full px-8 flex items-center transition-transform translate-x-full will-change-transform duration-300"
      data-navigation
    >
      <div class="flex flex-col justify-between h-full gap-24">
        <div class="flex items-center justify-between w-full">
          <div>
            <div class="w-48">
              <Logo />
            </div>
          </div>
          <div class="group">
            <div
              class="w-24 group-hover:text-neutral-900 transition-colors duration-300 cursor-pointer"
              data-close-button
            >
              <Close />
            </div>
          </div>
        </div>
        <nav>
          <ul class="space-y-4">
            {
              navItems.map((item) => (
                <li class="font-akira text-6xl relative group w-max">
                  <a href={item.href}>{item.label}</a>
                  <div class="absolute h-2 bg-neutral-900 w-full bottom-0 scale-x-0 transition-transform duration-450 origin-left group-hover:scale-x-100" />
                </li>
              ))
            }
          </ul>
        </nav>
        <div>
          {
            social.map((item) => {
              const Icon = icons[item.icon as keyof typeof icons];
              return (
                <a
                  href={item.url}
                  class="text-neutral-800 mr-4 w-18 inline-block hover:scale-105 transition-transform duration-300"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={item.name}
                >
                  <Icon />
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>

  <script>
    function setup() {
      const menuButton = document.querySelector("[data-menu-button]");
      const navbar = document.querySelector("[data-navbar]");
      const navigation = document.querySelector("[data-navigation]");
      const closeButton = document.querySelector("[data-close-button]");

      function lockScroll() {
        const scrollbarWidth =
          window.innerWidth - document.documentElement.clientWidth;
        document.body.style.overflow = "hidden";
        document.body.style.paddingRight = `${scrollbarWidth}px`;
      }

      function unlockScroll() {
        document.body.style.overflow = "";
        document.body.style.paddingRight = "";
      }

      function closeNav() {
        navigation?.classList.add("translate-x-full");
        navigation?.addEventListener(
          "transitionend",
          () => {
            navbar?.classList.add("hidden");
            unlockScroll();
          },
          { once: true },
        );
      }

      function onNavbarClick(e: Event) {
        if (e.target === navbar) closeNav();
      }

      function onMenuButtonClick() {
        const isOpen = !navbar?.classList.contains("hidden");
        if (isOpen) {
          closeNav();
        } else {
          navbar?.classList.remove("hidden");
          lockScroll();
          requestAnimationFrame(() => {
            navigation?.classList.remove("translate-x-full");
          });
        }
      }

      navbar?.addEventListener("click", onNavbarClick);
      menuButton?.addEventListener("click", onMenuButtonClick);
      closeButton?.addEventListener("click", onMenuButtonClick);

      document.addEventListener(
        "astro:before-swap",
        () => {
          navbar?.removeEventListener("click", onNavbarClick);
          menuButton?.removeEventListener("click", onMenuButtonClick);
        },
        { once: true },
      );
    }

    document.addEventListener("astro:page-load", setup);
  </script>
</div>
