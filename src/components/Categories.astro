---
import { categories } from "../data";
import ArrowIcon from "./ui/icons/ArrowIcon.astro";
import SectionTitle from "./ui/SectionTitle.astro";
---

<section class="bg-neutral-50 text-neutral-900 py-12" data-categories>
  <h2 class="text-6xl font-bold px-5 font-akira md:px-10 pb-12">Hacemos:</h2>
  {
    categories.map((category, index) => (
      <div
        class:list={["border-t border-neutral-900/10 px-5 md:px-10"]}
        data-category-row
      >
        <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-10 py-8 md:py-12 group">
          <h3 class="font-akira text-4xl md:text-4xl lg:text-5xl uppercase leading-[0.95] md:flex-1 group-hover:translate-x-5 transition-transform duration-400">
            {category.name}
          </h3>
          <p class="font-univers-ex text-base md:text-lg leading-snug md:max-w-md md:self-start md:pt-2 group-hover:-translate-x-5 transition-transform duration-400">
            {category.text}
          </p>
          <span
            class:list={[
              "w-7 h-7 md:w-9 md:h-9 shrink-0 md:self-start",
              index !== 0 && "-rotate-45",
            ]}
          >
            <ArrowIcon />
          </span>
        </div>
      </div>
    ))
  }
</section>
