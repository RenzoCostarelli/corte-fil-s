---
import type { ProjectDocument } from "../types/prismic";
import ArrowIcon from "./ui/icons/ArrowIcon.astro";
import ProjectCard from "./ui/ProjectCard.astro";
import SectionTitle from "./ui/SectionTitle.astro";

interface Props {
  posts?: ProjectDocument[];
}

const { posts = [] } = Astro.props;
const projects = posts.slice(0, 4);
---

<section class="pb-24 space-y-12 bg-neutral-50" data-portfolio-home>
  <div class="mx-auto">
    <SectionTitle
      title="Nuestros trabajos"
      class="text-neutral-950 text-center mb-12 px-4"
    />

    <div class="space-y-8" data-projects>
      {projects.map((post) => <ProjectCard post={post} from="/" />)}
    </div>
    <div class="w-full py-4 mt-4 text-center font-akira">
      <a
        href="/portfolio"
        class="w-max flex items-center font-bolder justify-self-center group text-neutral-50 bg-neutral-950 px-1 hover:px-5 transition-all duration-500"
        >Ver todos los proyectos
      </a>
    </div>
  </div>
</section>
