---
import Navbar from "./Navbar.astro";
import Logo from "./ui/Logo.astro";

const url = new URL(Astro.request.url);
const isHome = url.pathname === "/";
---

<div
  class:list={[
    "w-full flex items-center justify-between p-4 z-9999 relative -translate-y-full",
    { "translate-y-0": !isHome },
  ]}
  data-topbar
>
  <a href="/" class="w-24 text-white cursor-pointer">
    <Logo />
  </a>
  <Navbar />
</div>
<script>
  import { gsap } from "../lib/gsap";

  document.addEventListener("astro:page-load", () => {
    const topbar = document.querySelector(
      "[data-topbar]",
    ) as HTMLElement | null;
    if (!topbar) return;

    if (document.getElementById("loader")) {
      gsap.set(topbar, { yPercent: -500, opacity: 0 });
      window.addEventListener(
        "loader:done",
        () => {
          gsap.to(topbar, {
            yPercent: 0,
            opacity: 1,
            duration: 1,
            ease: "power4.out",
          });
        },
        { once: true },
      );
    } else {
      gsap.set(topbar, { yPercent: 0, opacity: 1 });
    }
  });
</script>
