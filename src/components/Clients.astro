---
import { clients } from "../data";
---

<section class="w-full py-16 overflow-hidden select-none" data-clients-marquee>
  <h2
    class:list={[
      "font-akira text-2xl md:text-4xl px-4 2xl:max-w-[75svw] text-transparent [-webkit-text-stroke:0.5px_white] md:[-webkit-text-stroke:1px_white] text-pretty",
    ]}
    data-section-title
  >
    Trabajamos con <span class="text-neutral-50"
      >marcas, artistas e instituciones</span
    > que buscan diferenciarse y generar impacto real
  </h2>

  <div data-track class="flex w-max will-change-transform pt-16">
    {
      clients.map((client) => (
        <div
          data-item
          data-original
          class="shrink-0 flex items-center justify-center border mr-5 px-8 py-5 min-w-40"
        >
          <img
            src={client.logo}
            alt={client.name}
            class="max-h-15 w-auto object-contain"
            loading="lazy"
          />
        </div>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from "../lib/gsap";

  let cleanup: (() => void) | null = null;

  function initClientsMarquee(): (() => void) | null {
    const root = document.querySelector<HTMLElement>("[data-clients-marquee]");
    const track = root?.querySelector<HTMLElement>("[data-track]");

    if (!root || !track) return null;

    // Drop any copies cloned by a previous init (e.g. re-running on the same DOM)
    track
      .querySelectorAll<HTMLElement>("[data-item]:not([data-original])")
      .forEach((el) => el.remove());

    const originalItems = Array.from(
      track.querySelectorAll<HTMLElement>("[data-item][data-original]"),
    );
    const setCount = originalItems.length;
    const oneSetWidth = track.scrollWidth;

    // Render enough copies so the track always covers at least one
    // viewport-width past a full set, however wide the screen is —
    // otherwise the mod-wrap below runs out of clones to show.
    const copies = Math.max(2, Math.ceil(window.innerWidth / oneSetWidth) + 1);

    for (let i = 1; i < copies; i++) {
      for (const item of originalItems) {
        track.appendChild(item.cloneNode(true));
      }
    }

    const items = Array.from(
      track.querySelectorAll<HTMLElement>("[data-item]"),
    );

    // Measure the width of one full set using bounding rects for accuracy
    const startX = items[0].getBoundingClientRect().left;
    const midX = items[setCount].getBoundingClientRect().left;
    const loopWidth = midX - startX;

    const BASE_SPEED = 80; // px/s forward
    const SCROLL_FACTOR = 0.12;
    const VELOCITY_LERP = 0.07;
    const DECAY_RATE = 0.04;

    let x = 0;
    let velocity = BASE_SPEED;
    let targetVelocity = BASE_SPEED;
    let lastScrollY = window.scrollY;
    let lastScrollTime = performance.now();

    const onScroll = () => {
      const now = performance.now();
      const dy = window.scrollY - lastScrollY;
      const dt = now - lastScrollTime;

      if (dt > 0) {
        const scrollVelocity = (dy / dt) * 1000; // px/s
        targetVelocity = BASE_SPEED + scrollVelocity * SCROLL_FACTOR;
        // Clamp so it doesn't go completely haywire
        targetVelocity = Math.max(-250, Math.min(450, targetVelocity));
      }

      lastScrollY = window.scrollY;
      lastScrollTime = now;
    };

    const tick = (_time: number, deltaTime: number) => {
      // Smooth velocity toward target
      velocity += (targetVelocity - velocity) * VELOCITY_LERP;

      // Decay target back to base speed when not scrolling
      targetVelocity += (BASE_SPEED - targetVelocity) * DECAY_RATE;

      // Advance position (positive velocity → move left)
      x -= velocity * (deltaTime / 1000);

      // Wrap x to (-loopWidth, 0] to create a seamless loop in both directions
      x = x % loopWidth;
      if (x > 0) x -= loopWidth;

      gsap.set(track, { x });
    };

    let resizeTimeout: ReturnType<typeof setTimeout> | undefined;
    const onResize = () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => void boot(), 200);
    };

    gsap.ticker.add(tick);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);

    return () => {
      clearTimeout(resizeTimeout);
      gsap.ticker.remove(tick);
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onResize);
      gsap.set(track, { x: 0 });
    };
  }

  async function boot(): Promise<void> {
    cleanup?.();
    if ("fonts" in document) await document.fonts.ready;
    cleanup = initClientsMarquee();
  }

  document.addEventListener("astro:page-load", () => void boot());
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>
