---
import * as prismic from "@prismicio/client";
import type { ProjectDocument } from "../../types/prismic";
import ArrowIcon from "./icons/ArrowIcon.astro";

interface Props {
  post: ProjectDocument;
  from?: string;
}

const { post, from } = Astro.props;
const slug = post.uid;
const href = from
  ? `/portfolio/${slug}?from=${encodeURIComponent(from)}`
  : `/portfolio/${slug}`;
const title = prismic.asText(post.data.title);
const thumbnail = post.data.miniatura?.url;
const clientName = post.data.client_name;
const category = post.data.category;
---

<a
  href={href}
  data-project-card
  data-category-item={category}
  class="rounded-sm overflow-hidden"
>
  <div
    class="bg-neutral-800 h-128 text-white gap-2 relative group overflow-hidden"
    style={`view-transition-name: portfolio-hero-${slug}`}
  >
    {
      thumbnail && (
        <img
          src={thumbnail}
          alt={title}
          class="w-full h-full object-cover absolute inset-0 group-hover:scale-105 transition-transform duration-500"
        />
      )
    }
    <div
      class="absolute left-3 bottom-3 w-max bg-white/2 backdrop-blur-sm px-3 pb-2 pt-12 max-w-[80%]"
    >
      {
        clientName && (
          <div class="text-xs uppercase font-semibold tracking-wider flex gap-2 items-center">
            <div class="h-1 w-1 bg-white" />
            {clientName}
          </div>
        )
      }
      <div class="text-lg font-akira tracking-wide">{title}</div>
    </div>
    <div class="absolute bottom-3 right-3">
      <div
        class="px-4 py-2 flex items-center gap-1 rounded-full backdrop-blur-sm translate-y-10 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 bg-white/2 group-hover:bg-white/4 transition-all duration-500"
      >
        <div class="font-semibold">Ver más</div>
        <div class="w-8 h-8">
          <ArrowIcon />
        </div>
      </div>
    </div>
  </div>
</a>
