  <div class="px-4">
    <div
      class="h-[100svh] mx-auto w-full scale-75 translate-y-[50%]"
      data-video
    >
      <video
        src="https://res.cloudinary.com/dkgnaegp9/video/upload/q_auto/f_auto/v1776356531/WhatsApp_Video_2026-04-07_at_14.10.14_e68hvc.mp4"
        class="w-full h-full object-cover shadow-md rounded-md overflow-hidden"
        autoplay
        loop
        muted
        playsinline
      >
        Your browser does not support the video tag.
      </video>
    </div>
  </div>
</header>
<script>
  import { gsap } from "../lib/gsap";

  const hero = document.querySelector("[data-hero]") as HTMLElement | null;
  const topbar = document.querySelector("[data-topbar]") as HTMLElement | null;
  const year = hero?.querySelector("[data-year]") as HTMLElement | null;
  const video = hero?.querySelector("[data-video]") as HTMLElement | null;
  const city = hero?.querySelector("[data-city]") as HTMLElement | null;
  function animateHeroIn() {
    if (!topbar || !video) return;

    // gsap.to(city, { x: 0, duration: 1.25, ease: "power2.out" });
    // gsap.to(year, { x: 0, duration: 1.25, ease: "power2.out" });
    const videoTl = gsap
      .timeline({ paused: true })
      .to(video, {
        opacity: 1,
        y: 0,
        duration: 1.25,
        ease: "power2.out",
        delay: 0.5,
      })
      .to(
        topbar,
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: "power2.out",
        },
        "<0.5",
      )
      .to(video, { scale: 1, duration: 1.25, ease: "power2.out" }, "-=1");

    videoTl.play();
  }

  if ((window as any).__loaderDone) {
    // Navigating back to home — animate in immediately, no loader
    animateHeroIn();
  } else {
    if (year && video) {
      gsap.set(video, { opacity: 0 });
      gsap.set(year, { y: 200 });
    }
    window.addEventListener("loader:done", animateHeroIn, { once: true });
  }
</script>
