<header
  class="text-neutral-700 gap-12 w-full relative overflow-hidden"
  data-hero
>
  <div class="px-4">
    <div class="h-[60svh] mx-auto w-full will-change-transform" data-video>
      <video
        src="https://res.cloudinary.com/dkgnaegp9/video/upload/q_auto/f_auto/v1776356531/WhatsApp_Video_2026-04-07_at_14.10.14_e68hvc.mp4"
        class="w-full h-full object-cover shadow-md rounded-md overflow-hidden"
        crossorigin="anonymous"
        autoplay
        loop
        muted
        playsinline
        data-hero-video
      >
        Your browser does not support the video tag.
      </video>
    </div>
  </div>
</header>

<script>
  import { gsap } from "../lib/gsap";
  import { createExperience } from "../scripts/experience";

  const experience = createExperience();

  const hero = document.querySelector("[data-hero]") as HTMLElement | null;

  if (hero) {
    const video = hero.querySelector("[data-video]") as HTMLElement | null;

    if (video) {
      const heroVideo = hero.querySelector(
        "[data-hero-video]",
      ) as HTMLVideoElement | null;
      if (heroVideo) {
        heroVideo.load();
        heroVideo.play().catch(() => {});
      }

      gsap.set(video, { opacity: 0, yPercent: 50, scale: 0.75 });

      gsap
        .timeline({
          onComplete: () =>
            window.dispatchEvent(new CustomEvent("hero:animated")),
        })
        .to(video, {
          opacity: 1,
          yPercent: 0,
          duration: 1.25,
          ease: "power2.out",
          delay: 0.5,
        })
        .to(video, { scale: 1, duration: 1.25, ease: "power2.out" }, "-=1")
        .call(
          () => window.dispatchEvent(new CustomEvent("hero:title-reveal")),
          [],
          "-=0.5",
        );

      try {
        experience.init(hero, { revealEvent: "hero:animated" });
      } catch (e) {
        console.warn("[Hero] Three.js experience failed to initialize:", e);
      }

      // Stop rendering while the hero is scrolled off-screen — the WebGL loop
      // runs every frame and shouldn't compete with scroll once it's not visible.
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            experience.resume();
          } else {
            experience.pause();
          }
        },
        { threshold: 0 },
      );
      observer.observe(hero);
    }
  }
</script>
