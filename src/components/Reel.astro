---

<section class="py-12 px-4" data-reel-section>
  <div class="mx-auto">
    <div class="py-8">
      <div
        class="bg-neutral-700 w-full md:h-screen rounded-md aspect-video mx-auto"
        data-reel
        data-link
      >
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "../lib/gsap";

  let ctx: gsap.Context | null = null;

  document.addEventListener("astro:page-load", () => {
    const reel = document.querySelector("[data-reel]") as HTMLElement | null;
    const section = document.querySelector(
      "[data-reel-section]",
    ) as HTMLElement | null;
    if (!reel || !section) return;

    ctx = gsap.context(() => {
      gsap.fromTo(
        reel,
        { scale: 0.75 },
        {
          scale: 1,
          ease: "none",
          scrollTrigger: {
            trigger: section,
            start: "top bottom",
            end: "center center",
            scrub: true,
          },
        },
      );
    });
  });

  document.addEventListener("astro:before-swap", () => {
    ctx?.revert();
    ctx = null;
  });
</script>
