---

<section class="pt-12 px-4" data-reel-section>
  <div class="mx-auto">
    <div class="pb-6 pt-8">
      <div
        class="bg-neutral-700 w-full md:h-[90svh] rounded-md aspect-video mx-auto"
        data-reel
        data-video
        data-link
      >
        <video
          src="https://res.cloudinary.com/rlebuswv/video/upload/f_auto,q_auto,w_1920/v1790868764/comprimido_prueba.mp4"
          class="w-full h-full object-cover shadow-md rounded-md overflow-hidden"
          crossorigin="anonymous"
          autoplay
          loop
          muted
          playsinline
          data-hero-video
        >
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "../lib/gsap";
  import { createExperience } from "../scripts/experience";

  let ctx: gsap.Context | null = null;
  const experience = createExperience();

  document.addEventListener("astro:page-load", () => {
    const reel = document.querySelector("[data-reel]") as HTMLElement | null;
    const section = document.querySelector(
      "[data-reel-section]",
    ) as HTMLElement | null;
    if (!reel || !section) return;

    const reelVideo = reel.querySelector(
      "[data-hero-video]",
    ) as HTMLVideoElement | null;
    if (reelVideo) {
      reelVideo.load();
      reelVideo.play().catch(() => {});
    }

    try {
      experience.init(reel);
    } catch (e) {
      console.warn("[Reel] Three.js experience failed to initialize:", e);
    }

    ctx = gsap.context(() => {
      gsap.fromTo(
        reel,
        { scale: 0.75 },
        {
          scale: 1,
          ease: "none",
          scrollTrigger: {
            trigger: section,
            start: "top bottom",
            end: "center center",
            scrub: true,
          },
        },
      );
    });
  });

  document.addEventListener("astro:before-swap", () => {
    ctx?.revert();
    ctx = null;
    experience.destroy();
  });
</script>
