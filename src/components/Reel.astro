---

<section class="pt-12" data-reel-section>
  <div class="mx-auto">
    <div class="pt-8">
      <div
        class="bg-neutral-700 w-full md:h-[90svh] overflow-hidden aspect-video mx-auto"
        data-reel
        data-video
        data-link
      >
        <video
          src="https://res.cloudinary.com/rlebuswv/video/upload/f_auto,q_auto,w_1920/v1790868764/comprimido_prueba.mp4"
          class="w-full h-full object-cover shadow-md"
          crossorigin="anonymous"
          autoplay
          loop
          muted
          playsinline
          data-hero-video
        >
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "../lib/gsap";
  import { createExperience } from "../scripts/experience";

  const experience = createExperience();

  const reel = document.querySelector("[data-reel]") as HTMLElement | null;
  const section = document.querySelector(
    "[data-reel-section]",
  ) as HTMLElement | null;

  if (reel && section) {
    const reelVideo = reel.querySelector(
      "[data-hero-video]",
    ) as HTMLVideoElement | null;
    if (reelVideo) {
      reelVideo.load();
      reelVideo.play().catch(() => {});
    }

    try {
      experience.init(reel);
    } catch (e) {
      console.warn("[Reel] Three.js experience failed to initialize:", e);
    }

    // Stop rendering while the reel is scrolled off-screen — the WebGL loop
    // runs every frame and shouldn't compete with scroll once it's not visible.
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          experience.resume();
        } else {
          experience.pause();
        }
      },
      { threshold: 0 },
    );
    observer.observe(reel);

    gsap.fromTo(
      reel,
      { scale: 0.75, borderRadius: "6px" },
      {
        scale: 1,
        borderRadius: "0px",
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top bottom",
          end: "center center",
          scrub: true,
        },
      },
    );
  }
</script>
