---
import SectionTitle from "./ui/SectionTitle.astro";
---

<section class="py-12 px-4" data-reel-section>
  <div class="mx-auto">
    <div class="py-8">
      <div
        class="bg-neutral-700 w-full aspect-video mx-auto"
        data-reel
        data-link
      >
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "../lib/gsap";

  const reel = document.querySelector("[data-reel]") as HTMLElement;
  const section = document.querySelector("[data-reel-section]") as HTMLElement;

  gsap.fromTo(
    reel,
    { scale: 0.75 },
    {
      scale: 1,
      ease: "none",
      scrollTrigger: {
        trigger: section,
        start: "top bottom",
        end: "center center",
        scrub: true,
      },
    },
  );
</script>
