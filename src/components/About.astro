---
import AboutCarousel from "./AboutCarousel.astro";
---

<section
  class="px-4 mx-auto flex flex-col relative pt-12 pb-12"
  data-container
  data-about-section
>
  <h2 class="md:text-5xl font-akira text-neutral-200 mb-6" data-about-title>
    Nosotros
  </h2>
  <p
    class="font-akira md:text-3xl 2xl:max-w-[65svw] text-transparent [-webkit-text-stroke:0.5px_white] text-balance"
    data-about-paragraph
  >
    Somos una <span class="text-neutral-200">productora audiovisual</span> con enfoque
    cinematografico, especializada en <span class="text-neutral-200"
      >transformar ideas</span
    > en piezas visuales con caracter, estetica y emocion.
  </p>

  <AboutCarousel />
</section>

<script>
  import "../scripts/about";
</script>
