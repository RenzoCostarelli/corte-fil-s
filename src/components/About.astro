---
import { portfolio } from "../data/portfolio";

const thumbnails = portfolio
  .filter((p) => p.thumbnail)
  .map((p) => p.thumbnail as string);

// Cycle through thumbnails to fill 6 trail image slots
const trailImages = Array.from(
  { length: 12 },
  (_, i) => thumbnails[i % thumbnails.length],
).filter(Boolean);
---

<section
  class="px-4 mx-auto h-svh flex flex-col relative py-12"
  data-container
  data-about-section
>
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    {
      trailImages.map((src) => (
        <img
          data-trail-img
          src={src}
          alt=""
          draggable="false"
          loading="eager"
          decoding="async"
          class="absolute object-cover select-none will-change-transform"
          style="width:140px;height:180px;opacity:0;pointer-events:none;tranform:scale(0.1);"
        />
      ))
    }
  </div>
  <h2 class="text-5xl font-akira text-neutral-100 mb-6">Nosotros</h2>
  <p
    class="text-neutral-100 text-4xl font-semibold font-univers-ex leading-tight tracking-wide relative z-10"
    data-about-paragraph
  >
    Somos una <span class="font-akira font-thin">productora audiovisual</span> con
    enfoque cinematografico, especializada en transformar ideas en piezas visuales
    con caracter, estetica y emocion.
  </p>
</section>

<script>
  import "../scripts/about";
</script>
