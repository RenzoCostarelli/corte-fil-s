---
import { portfolio } from "../data/portfolio";

const thumbnails = portfolio
  .filter((p) => p.thumbnail)
  .map((p) => p.thumbnail as string);

// Cycle through thumbnails to fill 6 trail image slots
const trailImages = Array.from(
  { length: 6 },
  (_, i) => thumbnails[i % thumbnails.length],
).filter(Boolean);
---

<section
  class="container px-4 mx-auto h-svh flex items-center relative overflow-hidden"
  data-container
  data-about-section
>
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    {
      trailImages.map((src) => (
        <img
          data-trail-img
          src={src}
          alt=""
          draggable="false"
          loading="eager"
          decoding="async"
          class="absolute object-cover select-none will-change-transform"
          style="width:220px;height:140px;opacity:0;pointer-events:none;"
        />
      ))
    }
  </div>

  <p
    class="text-neutral-100 text-5xl font-semibold text-center font-univers-ex leading-tight tracking-wide text-pretty relative z-10"
    data-about-paragraph
  >
    Somos una productora audiovisual con enfoque cinematográfico, especializada
    en transformar ideas en piezas visuales con carácter, estética y emoción.
  </p>
</section>

<script>
  import "../scripts/about";
</script>
