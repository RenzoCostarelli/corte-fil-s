---
import Font from "astro/components/Font.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Logo from "../components/ui/Logo.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import TopBar from "../components/TopBar.astro";
import CustomCursor from "../components/CustomCursor.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Corte Films</title>
    <Font cssVariable="--font-akira" preload />
    <Font cssVariable="--font-univers-ex" preload />
    <Font cssVariable="--font-univers-ex-obl" preload />
    <ClientRouter />
  </head>
  <body>
    <CustomCursor />
    <TopBar />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { initLenis } from "../lib/lenis";
      initLenis();
    </script>
    <script>
      import { initCursor } from "../scripts/cursor";
      document.addEventListener("astro:page-load", () => {
        initCursor();
      });
    </script>
    <script>
      document.addEventListener("astro:before-swap", (e) => {
        if (sessionStorage.getItem("loaderShown")) {
          const loader = (e as any).newDocument.getElementById("loader");
          if (loader) loader.remove();
        }
      });
    </script>
  </body>
</html>
